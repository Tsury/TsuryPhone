{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/events/config-delta-single.schema.json",
  "title": "Config Delta Event (Single)",
  "allOf": [
    { "$ref": "base-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "category": { "const": "config" },
        "event": { "const": "config_delta" },
        "key": { "type": "string", "minLength": 1 },
        "oldValue": {},
        "newValue": {}
      },
      "required": ["category", "event", "key", "newValue"],
      "additionalProperties": false
    }
  ]
}
